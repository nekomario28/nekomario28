{
  "version": 4,
  "base_theme": "dark",
  "surface": "github-profile-readme",
  "strategy": "seasonal visual envelope v3",
  "timezone": "Asia/Tokyo",
  "live_assets": {
    "hero": "assets/profile-hero.svg",
    "projects": "assets/profile-section-projects.svg",
    "activity": "assets/profile-section-activity.svg",
    "footer": "assets/profile-footer.svg"
  },
  "optional_assets": {
    "divider": "assets/profile-divider.svg"
  },
  "live_state": "design-lab/live-theme.json",
  "seasons": {
    "spring": {
      "months": [3, 4, 5],
      "hero": "seasons/spring-dark.svg",
      "accent": "#d99eaa",
      "motion": {
        "profile": "mist-and-sparse-petals",
        "implementation": "embedded-smil",
        "static_fallback": true,
        "live_verification": "NOT_RUN"
      },
      "auto_promote": true,
      "static_render": "PASS",
      "chrome": {
        "bg0": "#070b14",
        "bg1": "#121a2d",
        "accent2": "#d2b16f",
        "motif": "petal"
      }
    },
    "summer": {
      "months": [6, 7, 8],
      "hero": "seasons/summer-dark.svg",
      "accent": "#86aa94",
      "motion": {
        "profile": "rain-water-and-leaf-sway",
        "implementation": "embedded-smil",
        "static_fallback": true,
        "live_verification": "NOT_RUN"
      },
      "auto_promote": true,
      "static_render": "PASS",
      "chrome": {
        "bg0": "#06101a",
        "bg1": "#0c2d3b",
        "accent2": "#c7b06c",
        "motif": "water"
      }
    },
    "autumn": {
      "months": [9, 10, 11],
      "hero": "seasons/autumn-dark.svg",
      "accent": "#a84a2c",
      "motion": {
        "profile": "ember-and-sparse-leaves",
        "implementation": "embedded-smil",
        "static_fallback": true,
        "live_verification": "NOT_RUN"
      },
      "auto_promote": true,
      "static_render": "PASS",
      "chrome": {
        "bg0": "#070707",
        "bg1": "#18110f",
        "accent2": "#bc9652",
        "motif": "leaf"
      }
    },
    "winter": {
      "months": [12, 1, 2],
      "hero": "seasons/winter-dark.svg",
      "accent": "#9facbf",
      "motion": {
        "profile": "moon-haze-and-sparse-snow",
        "implementation": "embedded-smil",
        "static_fallback": true,
        "live_verification": "NOT_RUN"
      },
      "auto_promote": true,
      "static_render": "PASS",
      "chrome": {
        "bg0": "#05080e",
        "bg1": "#101827",
        "accent2": "#dfe7f2",
        "motif": "snow"
      }
    }
  },
  "constraints": [
    "GitHub page chrome cannot be overlaid or restyled from README content.",
    "The envelope is limited to the README rendering area.",
    "Static composition must remain complete if animation is unavailable.",
    "Dark theme is the design authority for this experiment.",
    "Automatic promotion may only use season entries with auto_promote=true and static_render=PASS.",
    "The live README references only stable assets; seasonal source paths stay inside the design lab.",
    "Optional animation must not carry essential information and must expose a reduced-motion fallback.",
    "Do not add a separator immediately after the hero when direct visual flow is stronger."
  ]
}
