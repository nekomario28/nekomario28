{
  "version": 3,
  "base_theme": "dark",
  "surface": "github-profile-readme",
  "strategy": "seasonal visual envelope v2",
  "timezone": "Asia/Tokyo",
  "live_assets": {
    "hero": "assets/profile-hero.svg",
    "divider": "assets/profile-divider.svg",
    "projects": "assets/profile-section-projects.svg",
    "activity": "assets/profile-section-activity.svg",
    "footer": "assets/profile-footer.svg"
  },
  "live_state": "design-lab/live-theme.json",
  "seasons": {
    "spring": {
      "months": [3, 4, 5],
      "hero": "seasons/spring-dark.svg",
      "accent": "#d99eaa",
      "motion_candidate": "sparse-petals",
      "auto_promote": true,
      "static_render": "PASS",
      "chrome": {
        "bg0": "#070b14",
        "bg1": "#121a2d",
        "accent2": "#d2b16f",
        "motif": "petal"
      }
    },
    "summer": {
      "months": [6, 7, 8],
      "hero": "seasons/summer-dark.svg",
      "accent": "#86aa94",
      "motion_candidate": "rain-and-water",
      "auto_promote": true,
      "static_render": "PASS",
      "chrome": {
        "bg0": "#06101a",
        "bg1": "#0c2d3b",
        "accent2": "#c7b06c",
        "motif": "water"
      }
    },
    "autumn": {
      "months": [9, 10, 11],
      "hero": "seasons/autumn-dark.svg",
      "accent": "#a84a2c",
      "motion_candidate": "sparse-leaves",
      "auto_promote": true,
      "static_render": "PASS",
      "chrome": {
        "bg0": "#070707",
        "bg1": "#18110f",
        "accent2": "#bc9652",
        "motif": "leaf"
