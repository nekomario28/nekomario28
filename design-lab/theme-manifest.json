    "winter": {
      "months": [12, 1, 2],
      "hero": "seasons/winter-dark.svg",
      "accent": "#9facbf",
      "motion_candidate": "sparse-snow",
      "auto_promote": true,
      "static_render": "PASS",
      "chrome": {
        "bg0": "#05080e",
        "bg1": "#101827",
        "accent2": "#dfe7f2",
        "motif": "snow"
      }
