{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nekomario28/project-incubator/schemas/agent-engineering/execution-admission-observation.schema.json",
  "title": "Execution admission observation",
  "description": "Read-only observation contract for deciding whether an already-authorized expensive payload was admitted by its owner-defined pre-payload gate. This schema does not define thresholds or grant cleanup, retry, dispatch, scheduling, or payload authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "observationId", "mode", "target", "gate", "checks", "decision", "payloadState", "evidence", "claimBoundary"],
  "properties": {
    "schemaVersion": {"const": 1},
    "observationId": {"type": "string", "minLength": 1},
    "mode": {"enum": ["LIVE", "HISTORICAL_REPLAY"]},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["owner", "resource", "revision", "workload"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "resource": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "workload": {"type": "string", "minLength": 1},
        "executionRef": {"type": "string", "minLength": 1}
      }
    },
    "gate": {
      "type": "object", "additionalProperties": false,
      "required": ["gateId", "phase", "authorityRef"],
      "properties": {
        "gateId": {"type": "string", "minLength": 1},
        "phase": {"const": "PRE_PAYLOAD"},
        "authorityRef": {"type": "string", "minLength": 1}
      }
    },
    "checks": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "required", "criterion", "observed", "outcome"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "criterion": {"type": "string", "minLength": 1},
          "observed": {"type": ["string", "number", "boolean", "null"]},
          "unit": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["PASS", "BLOCKED", "UNKNOWN"]}
        }
      },
      "contains": {"type": "object", "required": ["required"], "properties": {"required": {"const": true}}}
    },
    "decision": {"enum": ["PASS", "BLOCKED", "UNKNOWN"]},
    "payloadState": {"enum": ["NOT_STARTED", "STARTED", "UNKNOWN"]},
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["route", "locator"],
        "properties": {
          "route": {"enum": ["PROVIDER_API", "RUN_URL", "RUNNER_RECEIPT", "RESEARCH_RECEIPT", "WORKFLOW_DEFINITION", "OTHER"]},
          "locator": {"type": "string", "minLength": 1},
          "notes": {"type": "string", "minLength": 1}
        }
      }
    },
    "claimBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["proves", "doesNotProve"],
      "properties": {
        "proves": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "doesNotProve": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "BLOCKED"}}, "required": ["decision"]},
      "then": {"properties": {
        "payloadState": {"const": "NOT_STARTED"},
        "checks": {"contains": {"type": "object", "required": ["required", "outcome"], "properties": {"required": {"const": true}, "outcome": {"const": "BLOCKED"}}}}
      }}
    },
    {
      "if": {"properties": {"decision": {"const": "UNKNOWN"}}, "required": ["decision"]},
      "then": {"properties": {
        "payloadState": {"enum": ["NOT_STARTED", "UNKNOWN"]},
        "checks": {"contains": {"type": "object", "required": ["required", "outcome"], "properties": {"required": {"const": true}, "outcome": {"const": "UNKNOWN"}}}}
      }}
    },
    {
      "if": {"properties": {"decision": {"const": "PASS"}}, "required": ["decision"]},
      "then": {"properties": {
        "checks": {"not": {"contains": {"type": "object", "required": ["required", "outcome"], "properties": {"required": {"const": true}, "outcome": {"enum": ["BLOCKED", "UNKNOWN"]}}}}}
      }}
    },
    {
      "if": {"properties": {"payloadState": {"const": "STARTED"}}, "required": ["payloadState"]},
      "then": {"properties": {"decision": {"const": "PASS"}}}
    }
  ]
}
